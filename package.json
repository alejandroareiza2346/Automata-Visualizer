{
  "name": "automata-visualizer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage.enabled true --coverage.provider=c8 --coverage.reporter=text --coverage.reporter=html",
    "coverage:lcov": "vitest run --coverage.enabled true --coverage.provider=c8 --coverage.reporter=lcov",
    "format": "prettier --write .",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "type-check": "tsc --noEmit",
    "verify": "npm run type-check && npm run lint && npm test"
  },
  "dependencies": {
    "cytoscape": "^3.33.1",
    "cytoscape-svg": "^0.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.3.0",
    "@types/node": "^20.11.30",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.2.5",
    "typescript": "5.5.4",
    "vite": "^5.1.0",
    "vitest": "^1.5.0"
  }
}
